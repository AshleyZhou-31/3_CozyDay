DJANGO_SECRET_KEY=changeme
GOOGLE_OAUTH_CLIENT_ID=changeme
GOOGLE_OAUTH_CLIENT_SECRET=changeme

# Optional: local AI planner model (defaults to Qwen/Qwen2.5-3B-Instruct)
AI_PLANNER_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
AI_PLANNER_DEVICE=auto
AI_PLANNER_MAX_TIME_SECONDS=120
AI_PLANNER_MIN_RELEVANCE=0.35
AI_PLANNER_OUTPUT_VALIDATION=1

# Optional: external API AI planner
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_TIMEOUT_SECONDS=20

# Optional: error monitoring. Leave SENTRY_DSN empty to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Optional: assumed prices for the estimated-cost dashboard (USD per 1,000 tokens).
AI_COST_INPUT_USD_PER_1K=0.0002
AI_COST_OUTPUT_USD_PER_1K=0.0004
AI_SERVING_BACKEND=transformers-local
